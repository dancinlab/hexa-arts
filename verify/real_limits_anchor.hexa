#!hexa strict
// hexa-arts/verify/real_limits_anchor.hexa — real-limits-first anchor.
//
// Per LATTICE_POLICY.md §1.3 rule 2: each project's verify must use at
// least one anchor from §1.2 (Shannon · Kolmogorov · Bekenstein · c · ℏ ·
// k · Stefan-Boltzmann · Carnot · ASML throughput · ERCOT · etc.) and
// at least one engineering/industry threshold.
//
// hexa-arts's real-limits audit lives in LIMIT_BREAKTHROUGH.md (Wave M,
// 2026-05-12). This script confirms that file is present and references
// the canonical arts·culture·games·linguistics·religion HARD walls
// (perception physics + cognitive bandwidth + Shannon/Kolmogorov +
// market/resource ceilings) so any agent has a pointer from verify→audit.
//
// Honesty: no value here is computed against the n=6 lattice. Each anchor
// is sourced from cited authority in LIMIT_BREAKTHROUGH.md (Snellen / CIE
// CIELAB / Shannon 1948 / Kolmogorov / Cowan 2001 / Höge 1995 / McManus
// 2008 / Art Basel + UBS Market Report / ITU-R BT.2020).

let HOME = env("HOME")
let HEXA_ARTS_ROOT_ENV = env("HEXA_ARTS_ROOT")

fn shq(s: str) -> str {
    return "'" + s.replace("'", "'\\''") + "'"
}

fn _resolve_root() -> str {
    if HEXA_ARTS_ROOT_ENV.len() > 0 { return HEXA_ARTS_ROOT_ENV }
    let oldpwd = env("OLDPWD")
    if oldpwd.len() > 0 {
        let t = exec("[ -f " + shq(oldpwd) + "/hexa.toml ] && echo y || echo n").trim()
        if t == "y" { return oldpwd }
    }
    let pwd = env("PWD")
    if pwd.len() > 0 {
        let t = exec("[ -f " + shq(pwd) + "/hexa.toml ] && echo y || echo n").trim()
        if t == "y" { return pwd }
    }
    return HOME + "/core/hexa-arts"
}

fn _file_exists(p: str) -> bool {
    let r = exec("[ -f " + shq(p) + " ] && echo yes || echo no").trim()
    return r == "yes"
}

fn _file_contains(p: str, needle: str) -> bool {
    let cmd = "grep -F " + shq(needle) + " " + shq(p) + " >/dev/null 2>&1 && echo yes || echo no"
    let r = exec(cmd).trim()
    return r == "yes"
}

fn main() {
    let root = _resolve_root()
    println("hexa-arts/verify/real_limits_anchor — real-limits-first check")
    println("  root: " + root)
    println("")
    println("  policy: LATTICE_POLICY §1.3 rule 2 — at least 1 real limit anchor required")
    println("  source: LIMIT_BREAKTHROUGH.md (Wave M, arts·culture·games audit)")
    println("")

    let mut ok = 0
    let mut bad = 0

    // 1. Audit file must exist.
    let audit = root + "/LIMIT_BREAKTHROUGH.md"
    if _file_exists(audit) {
        println("  [PASS] LIMIT_BREAKTHROUGH.md present")
        ok = ok + 1
    } else {
        println("  [FAIL] LIMIT_BREAKTHROUGH.md missing (abs: " + audit + ")")
        bad = bad + 1
    }

    // 2. Audit must reference canonical arts/culture/games HARD walls.
    //    Each anchor is a sourced HARD/SOFT wall from LIMIT_BREAKTHROUGH.md §2.
    let anchors = [
        ["Visible-light band 380–780 nm",         "380–780 nm"],          // §2.1 perception HARD
        ["Audible band 20 Hz – 20 kHz",            "20 Hz"],               // §2.1 perception HARD
        ["Foveal acuity ~1 arcmin (Snellen 20/20)","Snellen"],             // §2.1 perception HARD
        ["Critical flicker fusion 50–90 Hz",       "Critical flicker"],    // §2.1 perception HARD
        ["CIELAB ΔE color JND",                    "CIELAB"],              // §2.1 perception SOFT
        ["Working-memory chunks 4 ± 1 (Cowan)",    "Cowan"],               // §2.2 cognition SOFT
        ["Shannon entropy bound (log₂|Σ|)",        "Shannon entropy"],     // §2.3 information HARD
        ["Kolmogorov complexity (uncomputable)",   "Kolmogorov complexity"],// §2.3 information HARD
        ["Art-market spend ~$65 B/yr",             "Art Basel"],           // §2.4 market SOFT
        ["LATTICE_POLICY §1.2 no-lattice-anchor",  "LATTICE_POLICY §1.2"], // §5 honesty caveat
    ]
    for a in anchors {
        let label = a[0]
        let needle = a[1]
        if _file_contains(audit, needle) {
            println("  [PASS] anchor referenced: " + label)
            ok = ok + 1
        } else {
            println("  [FAIL] anchor missing: " + label + " (needle: '" + needle + "')")
            bad = bad + 1
        }
    }

    // 3. Honesty caveat: external cultural entities must NEVER be lattice-fit
    //    (raw#10 C3 + LATTICE_POLICY §1.3 rule 4 + §3.3). The audit must
    //    explicitly disclaim n=6 lattice anchoring of arts markets / human
    //    perception.
    let unproven = [
        ["No n=6 lattice anchors disclaimer",  "No n=6 lattice anchors"],
        ["Aesthetic universality not claimed", "Aesthetic universality is not claimed"],
    ]
    for u in unproven {
        let label = u[0]
        let needle = u[1]
        if _file_contains(audit, needle) {
            println("  [PASS] external-entity caveat preserved: " + label)
            ok = ok + 1
        } else {
            println("  [FAIL] external-entity caveat MISSING: " + label)
            bad = bad + 1
        }
    }

    println("")
    println("  anchors verified: " + str(ok) + "  failures: " + str(bad))
    if bad > 0 {
        println("__HEXA_ARTS_REAL_LIMITS_ANCHOR__ FAIL")
        exit(1)
    }
    println("__HEXA_ARTS_REAL_LIMITS_ANCHOR__ PASS")
}
