#!hexa strict
// hexa-arts/cli/hexa-arts.hexa — standalone hexa-arts CLI router (🎨)
//
// 24-verb arts·culture·games·linguistics·religion substrate dispatcher.
// Extracted from canon@ded52144 on 2026-05-10.

let VERSION = "0.1.0"

let HOME = env("HOME")
let HEXA_ARTS_ROOT_ENV = env("HEXA_ARTS_ROOT")

fn hexa_root() -> str {
    if HEXA_ARTS_ROOT_ENV.len() > 0 { return HEXA_ARTS_ROOT_ENV }
    let inferred = exec("dirname \"$(dirname \"$0\")\" 2>/dev/null || true").trim()
    if inferred.len() > 0 { return inferred }
    return HOME + "/.hexa-arts"
}

let HM = hexa_root()
let LOG_PATH = HM + "/state/hexa_arts_cli.log"

fn verb_spec(verb: str) -> str {
    if verb == "ar_vr_xr" { return HM + "/ar-vr-xr/ar-vr-xr.md" }
    if verb == "archaeology" { return HM + "/archaeology/archaeology.md" }
    if verb == "audio" { return HM + "/audio/audio.md" }
    if verb == "baduk" { return HM + "/baduk/baduk.md" }
    if verb == "biometrics" { return HM + "/biometrics/biometrics.md" }
    if verb == "dance_choreography" { return HM + "/dance-choreography/dance-choreography.md" }
    if verb == "dice_probability" { return HM + "/dice-probability/dice-probability.md" }
    if verb == "ethnomusicology" { return HM + "/ethnomusicology/ethnomusicology.md" }
    if verb == "games_sports" { return HM + "/games-sports/games-sports.md" }
    if verb == "hangul_script" { return HM + "/hangul-script/hangul-script.md" }
    if verb == "library_science" { return HM + "/library-science/library-science.md" }
    if verb == "linguistics" { return HM + "/linguistics/linguistics.md" }
    if verb == "mountaineering" { return HM + "/mountaineering/mountaineering.md" }
    if verb == "music" { return HM + "/music/music.md" }
    if verb == "music_mathematics" { return HM + "/music-mathematics/music-mathematics.md" }
    if verb == "numismatics" { return HM + "/numismatics/numismatics.md" }
    if verb == "photography" { return HM + "/photography/photography.md" }
    if verb == "religion" { return HM + "/religion/religion.md" }
    if verb == "religion_mythology" { return HM + "/religion-mythology/religion-mythology.md" }
    if verb == "social_architecture" { return HM + "/social-architecture/social-architecture.md" }
    if verb == "taekwondo" { return HM + "/taekwondo/taekwondo.md" }
    if verb == "telecom_linguistics" { return HM + "/telecom-linguistics/telecom-linguistics.md" }
    if verb == "writing_systems" { return HM + "/writing-systems/writing-systems.md" }
    if verb == "yoga" { return HM + "/yoga/yoga.md" }
    return ""
}

let VERBS = ["ar_vr_xr", "archaeology", "audio", "baduk", "biometrics", "dance_choreography", "dice_probability", "ethnomusicology", "games_sports", "hangul_script", "library_science", "linguistics", "mountaineering", "music", "music_mathematics", "numismatics", "photography", "religion", "religion_mythology", "social_architecture", "taekwondo", "telecom_linguistics", "writing_systems", "yoga"]

fn shq(s: str) -> str {
    return "'" + s.replace("'", "'\\''") + "'"
}

fn has_flag(a: [str], flag: str) -> bool {
    for x in a {
        if x == flag { return true }
    }
    return false
}

fn json_mode(a: [str]) -> bool {
    return has_flag(a, "--json")
}

fn _ts_now() -> str { return exec("date -u '+%Y-%m-%dT%H:%M:%SZ'").trim() }

fn _audit(subcmd: str, args_str: str, exit_code: int) {
    let line = "{\"ts\":\"" + _ts_now() + "\",\"caller\":\"hexa_arts_standalone\",\"subcmd\":\"hexa-arts " +
               subcmd + "\",\"exit_code\":" + str(exit_code) + ",\"version\":\"" + VERSION + "\"}"
    exec("mkdir -p " + shq(HM + "/state") + " 2>/dev/null")
    exec("echo " + shq(line) + " >> " + shq(LOG_PATH) + " 2>/dev/null")
}

fn _file_exists(p: str) -> bool {
    let r = exec("[ -f " + shq(p) + " ] && echo yes || echo no").trim()
    return r == "yes"
}

fn cmd_list(a: [str]) {
    if json_mode(a) {
        let mut js = "{\"hexa_arts\":\"" + VERSION + "\",\"verbs_total\":24,"
        js = js + "\"verbs\":[\"ar_vr_xr\",\"archaeology\",\"audio\",\"baduk\",\"biometrics\",\"dance_choreography\",\"dice_probability\",\"ethnomusicology\",\"games_sports\",\"hangul_script\",\"library_science\",\"linguistics\",\"mountaineering\",\"music\",\"music_mathematics\",\"numismatics\",\"photography\",\"religion\",\"religion_mythology\",\"social_architecture\",\"taekwondo\",\"telecom_linguistics\",\"writing_systems\",\"yoga\"],"
        js = js + "\"verdict\":\"SPEC_CATALOG_ONLY\"}"
        println(js)
        return
    }
    println("hexa-arts " + VERSION + " — 24-verb arts·culture·games·linguistics·religion substrate (🎨)")
    println("")
    for v in VERBS { println("  " + v) }
    println("")
    println("  to read a verb spec:")
    println("    hexa-arts <verb>          (prints verb spec path + first lines)")
    println("    hexa-arts selftest        (24-verb spec presence sweep)")
}

fn cmd_verb(verb: str, a: [str]) {
    let spec = verb_spec(verb)
    if spec == "" {
        eprintln("hexa-arts: unknown verb '" + verb + "'")
        eprintln("run 'hexa-arts list' for the 24-verb table")
        _audit(verb, "unknown", 2)
        exit(2)
    }
    let present = _file_exists(spec)
    println("hexa-arts " + verb + " — arts·culture·games·linguistics·religion substrate (v" + VERSION + " spec)")
    println("  spec_path: " + spec)
    if present == false {
        eprintln("  status: MISSING")
        _audit(verb, "missing", 1)
        exit(1)
    }
    println("  status: PRESENT")
    println("  --- first 20 lines ---")
    let head = exec("head -20 " + shq(spec) + " 2>/dev/null")
    println(head.trim())
    println("  ----------------------")
    if json_mode(a) {
        let mut js = "{\"hexa_arts\":\"" + VERSION + "\",\"verb\":\"" + verb + "\",\"present\":true}"
        println(js)
    }
    _audit(verb, "", 0)
}

fn cmd_selftest(a: [str]) {
    let mut ok = 0
    let mut miss: [str] = []
    for v in VERBS {
        let spec = verb_spec(v)
        if _file_exists(spec) { ok = ok + 1 } else { miss = miss + [v] }
    }
    let total = len(VERBS)
    println("hexa-arts selftest — verb-spec presence sweep")
    println("  total verbs: " + str(total))
    println("  present:     " + str(ok) + "/" + str(total))
    if ok == total {
        println("__HEXA_ARTS_SELFTEST__ PASS")
        if json_mode(a) {
            println("{\"hexa_arts\":\"" + VERSION + "\",\"verdict\":\"PASS\",\"present\":" + str(ok) + ",\"total\":" + str(total) + "}")
        }
        _audit("selftest", "", 0)
        return
    }
    println("__HEXA_ARTS_SELFTEST__ FAIL")
    for m in miss { println("  missing: " + m) }
    _audit("selftest", "", 1)
    exit(1)
}

fn cmd_version() {
    println("hexa-arts " + VERSION)
    println("standalone arts·culture·games·linguistics·religion substrate library (extracted from canon@ded52144 on 2026-05-10)")
    println("license: MIT")
    println("repo:    https://github.com/dancinlab/hexa-arts")
}

fn cmd_help() {
    println("hexa-arts " + VERSION + " — 24-verb arts·culture·games·linguistics·religion substrate CLI (🎨)")
    println("")
    println("usage: hexa-arts <subcmd> [flags...]")
    println("")
    println("verb subcommands (24 total — see 'hexa-arts list'):")
    for v in VERBS { println("  " + v) }
    println("")
    println("utility subcommands:")
    println("  list             verb table")
    println("  selftest         24-verb spec presence sweep")
    println("")
    println("global flags:")
    println("  --version        show version")
    println("  --json           machine-parseable JSON tail")
    println("  --help, -h       this help")
    println("")
    println("env:")
    println("  HEXA_ARTS_ROOT       override repo root")
}

fn main() {
    let _raw = args()
    let mut _sidx = -1
    let mut _i = 0
    while _i < _raw.len() {
        if _raw[_i].ends_with(".hexa") { _sidx = _i; break }
        _i = _i + 1
    }
    let mut _user_start = 2
    if _sidx >= 0 { _user_start = _sidx + 1 }

    let mut a: [str] = ["hexa_arts_cli", "hexa_arts_router"]
    let mut _ua = _user_start
    while _ua < _raw.len() {
        a = a + [_raw[_ua]]
        _ua = _ua + 1
    }
    let n = len(a)

    if n < 3 { cmd_help(); return }

    let sub = a[2]

    if sub == "--version" || sub == "-V" || sub == "version" { cmd_version(); return }
    if has_flag(a, "--help") || has_flag(a, "-h") { cmd_help(); return }
    if sub == "help"      { cmd_help(); return }
    if sub == "list"      { cmd_list(a); return }
    if sub == "selftest"  { cmd_selftest(a); return }

    if verb_spec(sub) != "" { cmd_verb(sub, a); return }

    eprintln("hexa-arts: unknown subcommand '" + sub + "'")
    eprintln("run 'hexa-arts help' or 'hexa-arts list' for usage")
    _audit(sub, "", 2)
    exit(2)
}
